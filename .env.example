# Copy to .env and fill in. .env is gitignored and must never be committed.
#
#     cp .env.example .env
#
# Three independent roles. No single free provider covers all three, so they
# are configured separately. Every value below is a default that code/llm.py
# already uses -- you only strictly need to fill in the two API keys.

# --- Routing decisions (Tier 1 and Tier 2) --------------------------------
# Groq's free tier: 14,400 requests/day, 30,000 tokens/min.
# Get a key at https://console.groq.com  (no credit card)
#
# TOKENS bind here, not requests. A routing prompt is ~1,750 tokens, so 110
# messages is ~192,000 input tokens -- a 6.4 minute floor at 30,000/min, and
# an unpaced run would start getting 429s after about the first 17 messages.
# The client paces itself to stay under these numbers rather than discovering
# them the hard way. Set slightly below your real quota to leave headroom.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile
LLM_RPM=28
LLM_TPM=28000

# --- Image descriptions ---------------------------------------------------
# Groq has NO vision model since llama-4-scout was deprecated in June 2026,
# so images go to Gemini's free tier: 250 requests/day, 10/min. There are 20
# images and each is described once, then cached -- so 2 minutes, once ever.
# Get a key at https://aistudio.google.com/apikey  (no credit card)
VISION_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
VISION_API_KEY=
VISION_MODEL=gemini-2.5-flash
VISION_RPM=9
VISION_TPM=0

# --- Voice-note transcription ---------------------------------------------
# Groq hosts Whisper. Reuse the same key as LLM_API_KEY above.
# whisper-large-v3, not -turbo: turbo prunes the decoder 32 -> 4 layers, and
# the code-switched Hindi/English in this dataset is exactly where that hurts.
ASR_BASE_URL=https://api.groq.com/openai/v1
ASR_API_KEY=
ASR_MODEL=whisper-large-v3
ASR_RPM=18
ASR_TPM=0

# RPM/TPM notes:
#   0 disables that budget for the role.
#   Audio and image endpoints bill differently from chat, so their TPM is off
#   and only the request rate is paced.
#   On top of pacing, any 429 or 5xx is retried with exponential backoff and
#   honours the server's Retry-After header. A 401 is NOT retried -- a bad key
#   should fail loudly, not be masked as a rate limit.


# ==========================================================================
# FULLY LOCAL ALTERNATIVE -- no keys, no network, nothing metered.
# Install Ollama, then: ollama pull qwen2.5:7b && ollama pull llava
# Comment out everything above and uncomment this block.
#
# Note Ollama has no speech-to-text, so voice notes stay untranscribed and
# route on provenance alone unless you keep ASR_* pointed at Groq.
#
# Local models are not rate limited, so set RPM/TPM to 0 to disable pacing
# entirely -- otherwise you are throttling yourself for no reason.
# ==========================================================================
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=qwen2.5:7b
# LLM_RPM=0
# LLM_TPM=0
# VISION_BASE_URL=http://localhost:11434/v1
# VISION_API_KEY=ollama
# VISION_MODEL=llava
# VISION_RPM=0
